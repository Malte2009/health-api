model TrainingLog {
  id             String    @id @default(uuid())
  userId         String
  createdAt      DateTime  @default(now())
  changedAt      DateTime? @updatedAt
  name           String
  type           String?
  score          Float?
  notes          String?
  caloriesBurned Float?
  duration       Int?
  avgHeartRate   Int?
  pauses         Int       @default(0)
  pauseLength    Int       @default(0)

  abortedDueToSymptoms Boolean @default(false)
  abortSymptom         String?

  postExerciseBpSys Int? // Systolisch sofort nach Training
  postExerciseBpDia Int? // Diastolisch sofort nach Training
  postExerciseBpMin Int? // Nach wie vielen Minuten gemessen?

  hrvRecording      HrvRecording?
  bloodPressureLogs BloodPressureLog[]
  syncopeLogs       SyncopeLog[]

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseLogs ExerciseLog[]
}

model ExerciseLog {
  id         String    @id @default(uuid())
  exerciseId String
  name       String
  userId     String
  trainingId String
  createdAt  DateTime  @default(now())
  changedAt  DateTime? @updatedAt
  order      Int       @default(autoincrement())
  notes      String?

  sets     SetLog[]
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  training TrainingLog @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  exercise Exercise    @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
}

model Exercise {
  id     String @id @default(uuid())
  name   String
  userId String

  createdAt DateTime  @default(now())
  changedAt DateTime? @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseLogs ExerciseLog[]
}

model SetLog {
  id            String    @id @default(uuid())
  exerciseLogId String
  userId        String
  type          String?
  setTime       Int?
  createdAt     DateTime  @default(now())
  changedAt     DateTime? @updatedAt
  order         Int       @default(autoincrement())
  reps          Int
  repUnit       String    @default("Wdh.")
  weight        Float

  user        User        @relation(fields: [userId], references: [id])
  exerciseLog ExerciseLog @relation(fields: [exerciseLogId], references: [id], onDelete: Cascade)
}
