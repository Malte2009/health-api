enum SymptomType {
  HEADACHE
  DIZZINESS
  VISUAL_DISTURBANCE
  PULSATILE_TINNITUS
  NECK_PULSATION // NEU: Spürbarer Puls/Druck im Hals
  POSITIONAL_PULSE_SPIKE // NEU: Puls-Spike bei Lagerungswechsel (z.B. Umdrehen)
  CONGESTION_FEELING
  NAUSEA
  COGNITIVE_FOG
  FATIGUE
  FLUSHING
  URTICARIA
  DERMATOGRAPHISM
  GI_SYMPTOMS
  RESPIRATORY
  DYSPNEA
  CHEST_PRESSURE
  LIGHTHEADEDNESS
  OTHER
}

enum SyncopeType {
  ORTHOSTATIC // Schwarz vor Augen, Schwerkraft-abhängig
  SITTING // Amnesie, "Zeitsprung", ohne Prodromi
  SITUATIONAL // Nach Pressen (z. B. Gym), Husten
  UNCLASSIFIED
}

enum SyncopeOutcome {
  PRESYNCOPE // Beinahe-Ohnmacht
  SYNCOPE // Vollständiger Bewusstseinsverlust
}

model SymptomLog {
  id        String    @id @default(uuid())
  userId    String
  createdAt DateTime  @default(now())
  changedAt DateTime? @updatedAt

  timestamp DateTime
  name      SymptomType
  type      String      @default("Symptom")
  severity  Int // 1-10
  position  String?
  location  String?

  trigger          String?
  triggerFoodLogId String?  @unique
  triggerFoodLog   FoodLog? @relation(fields: [triggerFoodLogId], references: [id])

  worseOnBendingForward Boolean?
  worseOnLyingDown      Boolean?
  betterOnLyingDown     Boolean?
  pulsatile             Boolean?

  notes String?

  syncopeLogId String?
  syncopeLog   SyncopeLog? @relation(fields: [syncopeLogId], references: [id])

  pictures SymptomPicture[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SymptomPicture {
  id        String   @id @default(uuid())
  userId    String
  symptomId String
  createdAt DateTime @default(now())

  filePath String
  filename String
  mimetype String
  size     Int

  symptom SymptomLog @relation(fields: [symptomId], references: [id], onDelete: Cascade)
}

model SyncopeLog {
  id        String    @id @default(uuid())
  userId    String
  createdAt DateTime  @default(now())
  changedAt DateTime? @updatedAt

  timestamp DateTime
  name      SyncopeType
  type      String         @default("Syncope")
  outcome   SyncopeOutcome
  severity  Int // 1-10
  trigger   String?

  position String?

  amnesia                Boolean
  amnesiaDurationMinutes Int?

  activityBefore String?

  hoursSinceLastMeal  Float?
  hoursSinceLastDrink Float?
  saltSupplementation Boolean?

  injuries String?

  symptoms SymptomLog[]

  trainingLogId String?
  trainingLog   TrainingLog? @relation(fields: [trainingLogId], references: [id])

  notes String?
  user  User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DailyLog {
  id        String    @id @default(uuid())
  userId    String
  createdAt DateTime  @default(now())
  changedAt DateTime? @updatedAt

  date DateTime @unique

  energyMorning   Int?
  energyNoon      Int?
  energyAfternoon Int?
  energyEvening   Int?

  overallScore       Int?
  symptomBurdenScore Int?

  workCapacity  String?
  activityLevel String?

  targetWater_ml      Float?
  actualWater_ml      Float?
  saltSupplementedMg  Float?
  headElevatedSleep   Boolean?
  neckPositionManaged Boolean?

  syncopeCount    Int     @default(0)
  presyncopeCount Int     @default(0)
  worstSymptom    String?
  emergencyAction Boolean

  notes String?
  user  User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}
