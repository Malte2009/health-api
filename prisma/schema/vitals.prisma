enum HRContext {
  SLEEP_TURNING
  ORTHOSTATIC_TEST
  POST_EXERCISE
  PRESYNCOPE
  REST
  OTHER
}

model BloodPressureLog {
  id          String    @id @default(uuid())
  userId      String
  healthDayId String?
  createdAt   DateTime  @default(now())
  changedAt   DateTime? @updatedAt

  timestamp DateTime
  systolic  Int
  diastolic Int
  pulse     Int?
  position  String?
  context   String?

  hoursSinceLastCaffeine Decimal? @db.Decimal(10, 1)
  lastCaffeineAmountMg   Decimal? @db.Decimal(10, 1)

  minutesAfterPositionChange Int?

  symptoms String?
  arm      String?

  workoutId String?
  workout   Workout? @relation(fields: [workoutId], references: [id])

  healthDay HealthDay? @relation(fields: [healthDayId], references: [id], onDelete: SetNull)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([healthDayId])
  @@index([workoutId])
}

model SleepLog {
  id          String    @id @default(uuid())
  userId      String
  healthDayId String?
  createdAt   DateTime  @default(now())
  changedAt   DateTime? @updatedAt

  date DateTime

  sleepType String?

  hoursSinceLastCaffeine Decimal? @db.Decimal(10, 1)
  lastCaffeineAmountMg   Decimal? @db.Decimal(10, 1)

  // Subjektiv
  bedTime             DateTime?
  wakeTime            DateTime?
  sleepLatencyMinutes Int?
  wakeEpisodes        Int?
  subjectiveHours     Float?
  restedScore         Int? // 1-10 (WICHTIGSTES FELD)
  morningHeadache     Boolean?
  morningDizziness    Boolean?

  // Smart Watch
  totalSleepMinutes Int?
  awakeMinutes      Int?
  lightSleepMinutes Int?
  deepSleepMinutes  Int?
  remSleepMinutes   Int?

  // Puls-Spike Übersicht
  turningSpikeCount Int?
  turningSpikeMaxHr Int?

  // 1:1 Relation zur detaillierten Brustgurt-Aufnahme
  hrvRecording HrvRecording?

  notes     String?
  healthDay HealthDay? @relation(fields: [healthDayId], references: [id], onDelete: SetNull)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([healthDayId])
}
